# .gitignore Ce fichier empêche l'envoi de fichiers lourds ou sensibles sur GitHub.
# Environnement virtuel
venv/
backend/venv/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Fichiers sensibles
.env

# Données lourdes
data/raw/*.csv
data/raw/*.zip
data/processed/*.csv

# Modèles
models/*.pkl

# Flutter
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/ios/Pods/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Notebooks
.ipynb_checkpoints/

# Autoriser les échantillons (nécessaires pour le cloud)
!data/samples/
!data/samples/*.csv