# .gitignore Ce fichier empêche l'envoi de fichiers lourds ou sensibles sur GitHub.
# Environnement virtuel
venv/
backend/venv/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Fichiers sensibles
.env

# Données lourdes
data/raw/*.csv
data/raw/*.zip
data/processed/*.csv

# Modèles (optionnel - commentez si vous voulez les inclure)
models/*.pkl

# Flutter
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/ios/Pods/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Notebooks
.ipynb_checkpoints/